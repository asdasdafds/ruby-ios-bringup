# State that booted iOS with real Goodix touch (2026-10-22).
# These are provenance pins, not universal defaults for another device.
# Device-baseline hashes (GPT/boot/vbmeta) are intentionally NOT published.

MACOS_VERSION=13.5
KERNEL_CONFIG=DEVELOPMENT
MACHINE_CONFIG=SWEET

BASE_REPO=https://github.com/MakrSas/ios-topaz.git
BASE_SHA=5095ac19dbdcf37b64b81fe443f4027ad51b84bf
PATCHSET_SHA256=cf4008e309cfa566e3df968592a2d3f3224a9b3d0813d6054326115fecc0a03f
BASELINE_CHANGES_SHA256=1edb66332bb4daa8b1abcd6c4de77a0e88ed9c7e9bb4a2a7045a2696e53ab338

# Historical: harness commit that carried 0085 before this repository.
RUBY_COMMIT=8716a06

DXB_REPO=https://github.com/blacktop/darwin-xnu-build
DXB_SHA=663906528d1cd5ea8fde7de6f16de73db9511549

# The kernel that booted with real touch. It was built by the pinned harness
# from the same 88-file patchset (canonical hash above), so the source tree is
# identical. CI rebuilds are not promised to be byte-identical; record the
# artifact hash for each run. The exec-data hash is the artifact-level gate.
KERNEL_SHA256=9eb9acac8a4c936c1861fba1e0d29c105b714e8d0e6d407b48f4237076e6b947
KERNEL_CORE_SHA256=5bb77f52377c9d1400b42e462e4c9db8cd4d6cc40327ef2b7761a4629a0bc3ba
KERNEL_EXEC_DATA_SHA256=e4823afb97360e24708184d09c0dc6c9f7280e33d5c4aefbeb901b3fa9b11e3e
KERNEL_EXPECT_EXEC_DATA=e4823afb97360e24708184d09c0dc6c9f7280e33d5c4aefbeb901b3fa9b11e3e

# Filled after the first build from this repository (workflow run ID/hash).
CI_RUN_ID=
CI_KERNEL_SHA256=
CI_IMAGE_SHA256=

# Boot image that was flashed and booted. External; not in this repository.
IMAGE_SHA256=ace60d1645ec271cdbd55b7007456cb578168ca708382aafae8fbf506e68f6c8

# Named root/ICL artifacts (external; hashes only).
ROOT_SHA256=e698339d0e228609c2d98f16ae8dd44a5149f2ccc19a44b98d5d08845c53f96f
ROOT_PRE_BOOT_SHA256=985c30fcca28cb79e6ad6d30a1ff4b4b6b7306b69d6e480cd7cccf4fb5ca11e3
ROOT_CLEAN_SHA256=34c2882d3b722e53c9755dad3b74284d6ebba6f00256838d407ba3694b1a456d
ROOT_FIRST_BOOT_SHA256=55e2ab2c6e5494f473ece06a1c2bed728ed528bb257b67f01413d1aa51c76f11
ICL_ORIG_SHA256=ae3178046fe7cb9e08291c39dc4773429be26c35472c6fbd9135d5f2a225fd73
ICL_PATCHED_SHA256=4a4895422dcec766b90b65c067ecb06ef8fd3e346c03ee7e2464a85f62a73b74

# Host pipeline inputs (external; not in this repository).
SHIM_SHA256=63cd3f3529e37d169fb56b1f122fffbb295831c3fe05b7f88a756e8966676efc
PAYLOAD_SHA256=dbc57e96396f2e3e23213a76d300b1a329e2b4a320bc7363cf99ce0fc9e52b1c
PAYLOAD_OFF=0x14000
ADT_SHA256=c778d4b5a559ad7c4e8f54113cc8b4e7d91d34082efc91acb02e1fcce0099720
BASE_BOOT_SHA256=9f867d75ba10367394ded7842e99220c3b4265ef78ed4d3ab1aa2a0a2932a5c8

# Expected image/header layout for config-based checks (no golden image needed).
PAGE=2048
KERNEL_SIZE=16606685
RAW_LEN=37449728
SHIM_SIZE=12544
SWEETXNU_VERSION=1
SWEETXNU_NSEGS=10
SWEETXNU_VIRT_BASE=0xfffffe0006000000
SWEETXNU_ENTRY_VA=0xfffffe000748b488
SWEETXNU_ADT_OFF=0xfd6040
SWEETXNU_ADT_SIZE=0x2c6c
SWEETXNU_KERNEL_END_VA=0xfffffe00084c8000
SWEETXNU_PHYS_BASE=0x140000000
SWEETXNU_MEM_SIZE=0x80000000

BOOT_CMDLINE=config/0085-boot.cmdline
