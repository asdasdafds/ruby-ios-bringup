# 0142: the 0085 set + FocalTech FT3680 touch and MTK keypad buttons
# (patches/0142-ruby-fts-touch-keys.patch). New kernel: no booted
# reference yet, so the CI hash gate only records the segment hashes.

MACOS_VERSION=13.5
KERNEL_CONFIG=DEVELOPMENT
MACHINE_CONFIG=SWEET

BASE_REPO=https://github.com/MakrSas/ios-topaz.git
BASE_SHA=5095ac19dbdcf37b64b81fe443f4027ad51b84bf
PATCHSET_SHA256=b7e580a432fd5e185749da6ef64d759ab082ad9a607afe404d61b78c7dc4c151

DXB_REPO=https://github.com/blacktop/darwin-xnu-build
DXB_SHA=663906528d1cd5ea8fde7de6f16de73db9511549

# Same boot cmdline as 0085 with the root on userdata (128 GB ruby, no iosroot).
BOOT_CMDLINE=config/0085-boot.cmdline
