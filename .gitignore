# Firmware, images, dumps and logs are never committed
*.img
*.bin
*.elf
*.o
*.a
*.dtb
*.dtbo
*.dmg
*.ipsw
*.zip
*.7z
*.tar
*.gz
*.log
logs/
dumps/
out/
build/
__pycache__/
*.pyc

# Media: only the sanitized, allowlisted demo assets are tracked
media/*
!media/README.md
!media/README.zh.md
!media/.gitkeep
!media/CAPTURE.md
!media/CAPTURE.zh.md
!media/autoswipe.mp4
!media/home-screen.jpg

# Test fixtures are generated at runtime
testdata/*
!testdata/README.md

# OS noise
.DS_Store
Thumbs.db

# Local-only data: never committed or pushed
private/
