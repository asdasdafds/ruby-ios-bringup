+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * SWEET IOKit match trace: report the candidate services of a class-name
+ * provider match, so a missing IOServiceMatched delivery can be traced to
+ * "service not in the metaclass instance set" versus "state bit missing".
+ */
+static bool
+sweet_iokit_class_cand(const OSObject * obj, void * ctx)
+{
+	IOService *     s = (IOService *) obj;
+	unsigned int *  n = (unsigned int *) ctx;
+
+	(*n)++;
+	IOLog("SWEET IOX:   cand class=%s state=0x%x name=%s\n",
+	    s->getMetaClass()->getClassName(), s->getState(), s->getName());
+	return false;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
