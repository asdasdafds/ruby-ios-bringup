+/*
+ * ---- MTK keypad (mediatek,kp @ 0x10010000) ----
+ *
+ * KP_MEM1..5 hold the debounced matrix, one 16-bit word each, bit clear =
+ * pressed; hardware key n is MEM(n / 16) bit (n % 16).  ruby's live FDT:
+ * kpd-hw-init-map[0] = 114 (volume down), kpd-hw-pwrkey = 8 (116 power),
+ * kpd-hw-rstkey = 17 (115 volume up).  Every changed bit is logged so an
+ * unexpected layout shows up in sweetlog.  Read-only; LK leaves it running.
+ */
+#define KP_PA		0x10010000u
+#define KP_MEM(i)	(0x04u + (i) * 4u)
+#define KP_NMEM		5
+
+static const struct {
+	unsigned bit;
+	int key;	/* sweet_hid_key: 0 power, 1 volume up, 2 volume down */
+} kp_map[] = {
+	{ 0, 2 }, { 8, 0 }, { 17, 1 },
+};
+
+static int kp_sleep_chan;
+
+/*
+ * Power and volume-up are not in the keypad matrix on ruby (only hw key 0
+ * ever changes): they are MT6359 PWRKEY / HOMEKEY, read through the PMIC
+ * wrapper's AP software channel (WACS2, arbiter layout as Linux mtk-pmic-wrap
+ * mt6873; live FDT: mediatek,mt6877-pwrap @ 0x10026000).  Debounced state is
+ * MT6359 TOPSTATUS (0x2a): bit 1 PWRKEY, bit 3 HOMEKEY, clear = pressed
+ * (Linux mtk-pmic-keys).  Nothing is written to the PMIC.  Before polling,
+ * the channel must look idle and HWCID (0x08) must read 0x59xx; otherwise
+ * the PMIC keys stay off.  Boot-arg sweetpmickeys=0 disables them.
+ */
+#define PWRAP_PA		0x10026000u
+#define PWRAP_WACS2_CMD		0xc80
+#define PWRAP_SWINF2_RDATA	0xc94
+#define PWRAP_WACS2_VLDCLR	0xca4
+#define PWRAP_WACS2_RDATA	0xca8
+#define PWRAP_FSM(v)		(((v) >> 1) & 7)
+#define PWRAP_FSM_IDLE		0
+#define PWRAP_FSM_WFVLDCLR	6
+#define MT6359_HWCID		0x08
+#define MT6359_TOPSTATUS	0x2a
+#define MT6359_PWRKEY_DEB	(1u << 1)
+#define MT6359_HOMEKEY_DEB	(1u << 3)
+
+static vm_offset_t pwrap;
+
+static uint32_t
+pwrap_rd(uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(pwrap + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static bool
+pwrap_wait_fsm(uint32_t want)
+{
+	int i;
+
+	for (i = 0; i < 2000; i++) {
+		if (PWRAP_FSM(pwrap_rd(PWRAP_WACS2_RDATA)) == want) {
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+static bool
+pmic_read16(uint32_t adr, uint32_t *val)
+{
+	if (!pwrap_wait_fsm(PWRAP_FSM_IDLE)) {
+		return false;
+	}
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(pwrap + PWRAP_WACS2_CMD) = adr & 0xffff;
+	__asm__ volatile("dsb osh" ::: "memory");
+	if (!pwrap_wait_fsm(PWRAP_FSM_WFVLDCLR)) {
+		return false;
+	}
+	*val = pwrap_rd(PWRAP_SWINF2_RDATA) & 0xffff;
+	*(volatile uint32_t *)(pwrap + PWRAP_WACS2_VLDCLR) = 1;
+	__asm__ volatile("dsb osh" ::: "memory");
+	return true;
+}
+
+static bool
+pmic_keys_init(void)
+{
+	int enabled = 1;
+	uint32_t st, id = 0;
+
+	if (PE_parse_boot_argn("sweetpmickeys", &enabled, sizeof(enabled)) && !enabled) {
+		printf("SWEET KEYS: PMIC keys disabled (sweetpmickeys=0)\n");
+		return false;
+	}
+	pwrap = ml_io_map(PWRAP_PA, 0x1000);
+	if (!pwrap) {
+		return false;
+	}
+	st = pwrap_rd(PWRAP_WACS2_RDATA);
+	if (PWRAP_FSM(st) != PWRAP_FSM_IDLE) {
+		printf("SWEET KEYS: pwrap WACS2 not idle (%08x); PMIC keys off\n", st);
+		return false;
+	}
+	if (!pmic_read16(MT6359_HWCID, &id) || (id >> 8) != 0x59) {
+		printf("SWEET KEYS: PMIC HWCID %04x (want 59xx); PMIC keys off\n", id);
+		return false;
+	}
+	printf("SWEET KEYS: MT6359 HWCID %04x via pwrap, polling power/volume-up\n", id);
+	return true;
+}
