+/*
+ * ---- FocalTech FT3680, V3 SPI protocol (GPL FocalTech focaltech_spi.c) ----
+ *
+ * Read: [reg, 0xa0 (read | data CRC), len_hi, len_lo, 3 dummy] then data and
+ * a CRC-16 (reflected 0x8408, init 0xffff, little-endian) over the data;
+ * rx[3] & 0xa0 must be 0.  Frames over 64 bytes are padded to 4 bytes and
+ * the length field covers the padding.  CS stays high >= 150 us between.
+ *
+ * Touch frame: register 0x01, 63 bytes.  d[1] & 0x0f points, then 6-byte
+ * records from d[2]: XH (event<<6 | x[11:8]), XL, YH (id<<4 | y[11:8]), YL,
+ * pressure, area.  Event 0 down, 1 up, 2 contact; id >= 0x0a ends the list.
+ */
+#define FTS_READ_CMD		0xa0
+#define FTS_DP			(4 + 3)
+#define FTS_CS_HIGH_US		150
+#define FTS_REG_TOUCH		0x01
+#define FTS_REG_CHIP_ID		0xa3
+#define FTS_REG_CHIP_ID2	0x9f
+#define FTS_REG_FW_VER		0xa6
+#define FTS_TOUCH_LEN		63
+#define FTS_MAX_ID		0x0a
+#define FTS_XFER_MAX		80
+#define FTS_LOG_FRAMES		24
+
+static unsigned fts_logged;
+
+static uint16_t
+fts_crc(const uint8_t *p, unsigned n)
+{
+	uint16_t crc = 0xffff;
+	unsigned i;
+	int b;
+
+	for (i = 0; i < n; i++) {
+		crc ^= p[i];
+		for (b = 0; b < 8; b++) {
+			crc = (crc & 1) ? (uint16_t)((crc >> 1) ^ 0x8408)
+			    : (uint16_t)(crc >> 1);
+		}
+	}
+	return crc;
+}
+
+static int
+fts_read(uint8_t reg, uint8_t *data, unsigned len)
+{
+	uint8_t tx[FTS_XFER_MAX], rx[FTS_XFER_MAX];
+	unsigned txlen = FTS_DP + len + 2, dlen = len, i;
+	int attempt;
+
+	if (txlen > 64) {
+		unsigned aligned = (txlen + 3) & ~3u;
+
+		dlen += aligned - txlen;
+		txlen = aligned;
+	}
+	if (txlen > sizeof(tx)) {
+		return EINVAL;
+	}
+	for (i = 0; i < txlen; i++) {
+		tx[i] = 0;
+	}
+	tx[0] = reg;
+	tx[1] = FTS_READ_CMD;
+	tx[2] = (dlen >> 8) & 0xff;
+	tx[3] = dlen & 0xff;
+
+	for (attempt = 0; attempt < 3; attempt++) {
+		spi_xfer(tx, rx, txlen);
+		delay(FTS_CS_HIGH_US);
+		if (rx[3] & 0xa0) {
+			continue;
+		}
+		if (fts_crc(&rx[FTS_DP], dlen) !=
+		    (uint16_t)(rx[FTS_DP + dlen] | (rx[FTS_DP + dlen + 1] << 8))) {
+			continue;
+		}
+		for (i = 0; i < len; i++) {
+			data[i] = rx[FTS_DP + i];
+		}
+		return 0;
+	}
+	return EIO;
+}
+
+static bool
+fts_probe(void)
+{
+	uint8_t id = 0, id2 = 0, fw = 0;
+	int i;
+
+	for (i = 0; i < 10; i++) {
+		if (fts_read(FTS_REG_CHIP_ID, &id, 1) == 0 && id != 0x00 && id != 0xff) {
+			(void)fts_read(FTS_REG_CHIP_ID2, &id2, 1);
+			(void)fts_read(FTS_REG_FW_VER, &fw, 1);
+			printf("SWEET FTS: chip id %02x/%02x fw %02x, ready\n", id, id2, fw);
+			return true;
+		}
+		gt_wait(100);
+	}
+	printf("SWEET FTS: no chip id (last %02x)\n", id);
+	return false;
+}
+
+static int
+fts_frame(void)
+{
+	uint8_t d[FTS_TOUCH_LEN];
+	uint32_t mask = 0, n;
+	int i;
+
+	if (fts_read(FTS_REG_TOUCH, d, sizeof(d)) != 0) {
+		return EIO;
+	}
+	if (d[1] == 0xff && d[2] == 0xff && d[3] == 0xff) {
+		return EAGAIN;	/* firmware not ready / ESD pattern */
+	}
+	n = d[1] & 0x0f;
+	if (n > GT_MAX) {
+		return EIO;
+	}
+	/* The first frames with fingers go to the log to confirm the layout. */
+	if (n && fts_logged < FTS_LOG_FRAMES) {
+		fts_logged++;
+		printf("SWEET FTS: raw n=%u %02x %02x | %02x %02x %02x %02x %02x %02x"
+		    " | %02x %02x %02x %02x %02x %02x\n", n, d[0], d[1],
+		    d[2], d[3], d[4], d[5], d[6], d[7],
+		    d[8], d[9], d[10], d[11], d[12], d[13]);
+	}
+
+	for (i = 0; i < GT_MAX; i++) {
+		const uint8_t *p = &d[2 + 6 * i];
+		uint32_t id = p[2] >> 4, ev = p[0] >> 6, x, y;
+
+		if (id >= FTS_MAX_ID) {
+			break;
+		}
+		if (ev == 1 || (mask & (1u << id))) {
+			continue;	/* lifted, or a duplicate id */
+		}
+		x = ((uint32_t)(p[0] & 0x0f) << 8) | p[1];
+		y = ((uint32_t)(p[2] & 0x0f) << 8) | p[3];
+		if (x > 1079) {
+			x = 1079;
+		}
+		if (y > 2399) {
+			y = 2399;
+		}
+		mask |= 1u << id;
+		gt.x[id] = (int)x;
+		gt.y[id] = (int)y;
+	}
+
+	for (i = 0; i < GT_MAX; i++) {
+		if (mask & (1u << i)) {
+			sweet_hid_touch(i, 1, gt.x[i], gt.y[i]);
+		} else if (gt.active & (1u << i)) {
+			sweet_hid_touch(i, 0, gt.x[i], gt.y[i]);
+		}
+	}
+	gt.active = mask;
+	return 0;
+}
