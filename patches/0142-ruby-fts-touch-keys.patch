+/*
+ * ---- FocalTech FT3680, V3 SPI protocol (GPL FocalTech focaltech_spi.c) ----
+ *
+ * Read: [reg, 0xa0 (read | data CRC), len_hi, len_lo, 3 dummy] then data and
+ * a CRC-16 (reflected 0x8408, init 0xffff, little-endian) over the data;
+ * rx[3] & 0xa0 must be 0.  Frames over 64 bytes are padded to 4 bytes and
+ * the length field covers the padding.  CS stays high >= 150 us between.
+ *
+ * Touch frame: register 0x01, 63 bytes.  d[1] & 0x0f points, then 6-byte
+ * records from d[2]: XH (event<<6 | x[11:8]), XL, YH (id<<4 | y[11:8]), YL,
+ * pressure, area.  Event 0 down, 1 up, 2 contact; id >= 0x0a ends the list.
+ */
+#define FTS_READ_CMD		0xa0
+#define FTS_DP			(4 + 3)
+#define FTS_CS_HIGH_US		150
+#define FTS_REG_TOUCH		0x01
+#define FTS_REG_CHIP_ID		0xa3
+#define FTS_REG_CHIP_ID2	0x9f
+#define FTS_REG_FW_VER		0xa6
+#define FTS_TOUCH_LEN		63
+#define FTS_MAX_ID		0x0a
+#define FTS_XFER_MAX		80
+#define FTS_LOG_FRAMES		24
+
+static unsigned fts_logged;
+
+static uint16_t
+fts_crc(const uint8_t *p, unsigned n)
+{
+	uint16_t crc = 0xffff;
+	unsigned i;
+	int b;
+
+	for (i = 0; i < n; i++) {
+		crc ^= p[i];
+		for (b = 0; b < 8; b++) {
+			crc = (crc & 1) ? (uint16_t)((crc >> 1) ^ 0x8408)
+			    : (uint16_t)(crc >> 1);
+		}
+	}
+	return crc;
+}
+
+static int
+fts_read(uint8_t reg, uint8_t *data, unsigned len)
+{
+	uint8_t tx[FTS_XFER_MAX], rx[FTS_XFER_MAX];
+	unsigned txlen = FTS_DP + len + 2, dlen = len, i;
+	int attempt;
+
+	if (txlen > 64) {
+		unsigned aligned = (txlen + 3) & ~3u;
+
+		dlen += aligned - txlen;
+		txlen = aligned;
+	}
+	if (txlen > sizeof(tx)) {
+		return EINVAL;
+	}
+	for (i = 0; i < txlen; i++) {
+		tx[i] = 0;
+	}
+	tx[0] = reg;
+	tx[1] = FTS_READ_CMD;
+	tx[2] = (dlen >> 8) & 0xff;
+	tx[3] = dlen & 0xff;
+
+	for (attempt = 0; attempt < 3; attempt++) {
+		spi_xfer(tx, rx, txlen);
+		delay(FTS_CS_HIGH_US);
+		if (rx[3] & 0xa0) {
+			continue;
+		}
+		if (fts_crc(&rx[FTS_DP], dlen) !=
+		    (uint16_t)(rx[FTS_DP + dlen] | (rx[FTS_DP + dlen + 1] << 8))) {
+			continue;
+		}
+		for (i = 0; i < len; i++) {
+			data[i] = rx[FTS_DP + i];
+		}
+		return 0;
+	}
+	return EIO;
+}
+
+/*
+ * The FT3680 has no flash: after every reset its ROM loader answers 0xef to
+ * all application registers until the host writes the 127300-byte app into
+ * PRAM, checks the loader's ECC and starts it (the vendor V3.3 driver's
+ * fts_pram_write_ecc; sequence as in the GPL mainline FocalTech FT8203 SPI
+ * driver).  The image is the phone's /vendor/firmware/focaltech_ts_fw.bin,
+ * passed in the ADT as /sweet-fts "firmware" (tools/mkadt_ruby.py --fts-fw)
+ * so it never lives in this tree.
+ */
+#define FTS_CMD_START1		0x55
+#define FTS_CMD_READ_ID		0x90
+#define FTS_CMD_SET_ADDR	0xad
+#define FTS_CMD_PRAM_WRITE	0xae
+#define FTS_CMD_START_APP	0x08
+#define FTS_CMD_ECC		0xcc
+#define FTS_CMD_ECC_READ	0xcd
+#define FTS_CMD_ECC_FINISH	0xce
+#define FTS_ECC_OK		0xa5
+#define FTS_ROM_ID_H		0x56
+#define FTS_ROM_ID_L		0x62
+#define FTS_APP_ID		0x56
+#define FTS_PRAM_PACKET		4092
+#define FTS_WR_MAX		(4 + 3 + FTS_PRAM_PACKET)
+/* ECC: reflected CRC over big-endian 16-bit words (0x9299 for ruby's image) */
+#define FTS_ECC_POLY		((1u << 15) | (1u << 10) | (1u << 3))
+
+static uint8_t fts_wtx[FTS_WR_MAX], fts_wrx[FTS_WR_MAX];
+
+/* Writes: [cmd, 0x00, len_hi, len_lo] then, with a payload, 3 dummy + data. */
+static int
+fts_write(uint8_t cmd, const uint8_t *data, unsigned len)
+{
+	unsigned total = 4 + (len ? 3 + len : 0), i;
+	int attempt;
+
+	if (total > sizeof(fts_wtx)) {
+		return EINVAL;
+	}
+	for (attempt = 0; attempt < 3; attempt++) {
+		for (i = 0; i < total; i++) {
+			fts_wtx[i] = 0;
+		}
+		fts_wtx[0] = cmd;
+		fts_wtx[1] = 0x00;
+		fts_wtx[2] = (len >> 8) & 0xff;
+		fts_wtx[3] = len & 0xff;
+		for (i = 0; i < len; i++) {
+			fts_wtx[7 + i] = data[i];
+		}
+		spi_xfer(fts_wtx, fts_wrx, total);
+		delay(FTS_CS_HIGH_US);
+		if (!(fts_wrx[3] & 0xa0)) {
+			return 0;
+		}
+	}
+	return EIO;
+}
+
+static void
+fts_reset_pulse(void)
+{
+	gt_wr(GT_RESET_DO, gt_rd(GT_RESET_DO) & ~GT_RESET);
+	gt_wait(2);
+	gt_wr(GT_RESET_DO, gt_rd(GT_RESET_DO) | GT_RESET);
+}
+
+static bool
+fts_enter_boot(void)
+{
+	uint8_t id[2];
+	int i, j;
+
+	for (i = 0; i < 30; i++) {
+		fts_reset_pulse();
+		gt_wait(8);
+		for (j = 0; j < 30; j++) {
+			if (fts_write(FTS_CMD_START1, NULL, 0) == 0) {
+				gt_wait(8);
+				if (fts_read(FTS_CMD_READ_ID, id, 2) == 0 &&
+				    id[0] == FTS_ROM_ID_H && id[1] == FTS_ROM_ID_L) {
+					return true;
+				}
+			}
+			gt_wait(1);
+		}
+	}
+	return false;
+}
+
+static uint16_t
+fts_ecc_host(const uint8_t *p, uint32_t len)
+{
+	uint16_t ecc = 0;
+	uint32_t i;
+	int j;
+
+	for (i = 0; i + 1 < len; i += 2) {
+		ecc ^= (uint16_t)((p[i] << 8) | p[i + 1]);
+		for (j = 0; j < 16; j++) {
+			ecc = (ecc & 1) ? (uint16_t)((ecc >> 1) ^ FTS_ECC_POLY)
+			    : (uint16_t)(ecc >> 1);
+		}
+	}
+	return ecc;
+}
+
+static int
+fts_ecc_chip(uint32_t len, uint16_t *ecc)
+{
+	uint8_t cmd[6] = { 0, 0, 0, (len >> 16) & 0xff, (len >> 8) & 0xff, len & 0xff };
+	uint8_t v[2] = { 0, 0 };
+	int i;
+
+	if (fts_write(FTS_CMD_ECC, cmd, sizeof(cmd)) != 0) {
+		return EIO;
+	}
+	gt_wait(3);
+	for (i = 0; i < 100; i++) {
+		if (fts_read(FTS_CMD_ECC_FINISH, v, 1) != 0) {
+			return EIO;
+		}
+		if (v[0] == FTS_ECC_OK) {
+			break;
+		}
+		gt_wait(2);
+	}
+	if (v[0] != FTS_ECC_OK) {
+		printf("SWEET FTS: ecc never finished (%02x)\n", v[0]);
+		return ETIMEDOUT;
+	}
+	if (fts_read(FTS_CMD_ECC_READ, v, 2) != 0) {
+		return EIO;
+	}
+	*ecc = (uint16_t)((v[0] << 8) | v[1]);
+	return 0;
+}
+
+static bool
+fts_download(void)
+{
+	DTEntry node;
+	void const *prop;
+	unsigned int size;
+	const uint8_t *fw;
+	uint32_t off;
+	uint16_t host, chip = 0;
+	uint8_t addr[3];
+
+	if (SecureDTLookupEntry(NULL, "/sweet-fts", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "firmware", &prop, &size) != kSuccess ||
+	    size < 0x200 || size > 0x40000) {
+		printf("SWEET FTS: no /sweet-fts firmware in the ADT\n");
+		return false;
+	}
+	fw = (const uint8_t *)prop;
+	if (((uint32_t)((fw[0x100] << 8) | fw[0x101]) + ((fw[0x102] << 8) | fw[0x103])) != 0xffff) {
+		printf("SWEET FTS: bad firmware header\n");
+		return false;
+	}
+	if (!fts_enter_boot()) {
+		printf("SWEET FTS: no ROM boot id %02x %02x\n", FTS_ROM_ID_H, FTS_ROM_ID_L);
+		return false;
+	}
+	for (off = 0; off < size; off += FTS_PRAM_PACKET) {
+		unsigned chunk = size - off < FTS_PRAM_PACKET ? size - off : FTS_PRAM_PACKET;
+
+		addr[0] = (off >> 16) & 0xff;
+		addr[1] = (off >> 8) & 0xff;
+		addr[2] = off & 0xff;
+		if (fts_write(FTS_CMD_SET_ADDR, addr, sizeof(addr)) != 0 ||
+		    fts_write(FTS_CMD_PRAM_WRITE, fw + off, chunk) != 0) {
+			printf("SWEET FTS: pram write failed at %x\n", off);
+			return false;
+		}
+	}
+	host = fts_ecc_host(fw, size);
+	if (fts_ecc_chip(size, &chip) != 0 || chip != host) {
+		printf("SWEET FTS: ecc mismatch chip %04x host %04x\n", chip, host);
+		return false;
+	}
+	if (fts_write(FTS_CMD_START_APP, NULL, 0) != 0) {
+		printf("SWEET FTS: start app failed\n");
+		return false;
+	}
+	printf("SWEET FTS: firmware %u bytes in pram, ecc %04x, started\n", size, host);
+	gt_wait(100);
+	return true;
+}
+
+static bool
+fts_probe(void)
+{
+	uint8_t id = 0, id2 = 0, fw = 0;
+	int i;
+
+	if (!fts_download()) {
+		return false;
+	}
+	for (i = 0; i < 20; i++) {
+		if (fts_read(FTS_REG_CHIP_ID, &id, 1) == 0 && id == FTS_APP_ID) {
+			(void)fts_read(FTS_REG_CHIP_ID2, &id2, 1);
+			(void)fts_read(FTS_REG_FW_VER, &fw, 1);
+			printf("SWEET FTS: chip id %02x/%02x fw %02x, ready\n", id, id2, fw);
+			return true;
+		}
+		gt_wait(50);
+	}
+	printf("SWEET FTS: firmware not running (id %02x)\n", id);
+	return false;
+}
+
+static int
+fts_frame(void)
+{
+	uint8_t d[FTS_TOUCH_LEN];
+	uint32_t mask = 0, n;
+	int i;
+
+	if (fts_read(FTS_REG_TOUCH, d, sizeof(d)) != 0) {
+		return EIO;
+	}
+	if (d[1] == 0xef || d[1] == 0xff) {
+		return EAGAIN;	/* ROM loader (0xef) or not ready / ESD (0xff) */
+	}
+	n = d[1] & 0x0f;
+	if (n > GT_MAX) {
+		return EIO;
+	}
+	/* The first frames with fingers go to the log to confirm the layout. */
+	if (n && fts_logged < FTS_LOG_FRAMES) {
+		fts_logged++;
+		printf("SWEET FTS: raw n=%u %02x %02x | %02x %02x %02x %02x %02x %02x"
+		    " | %02x %02x %02x %02x %02x %02x\n", n, d[0], d[1],
+		    d[2], d[3], d[4], d[5], d[6], d[7],
+		    d[8], d[9], d[10], d[11], d[12], d[13]);
+	}
+
+	for (i = 0; i < GT_MAX; i++) {
+		const uint8_t *p = &d[2 + 6 * i];
+		uint32_t id = p[2] >> 4, ev = p[0] >> 6, x, y;
+
+		if (id >= FTS_MAX_ID) {
+			break;
+		}
+		if (ev == 1 || (mask & (1u << id))) {
+			continue;	/* lifted, or a duplicate id */
+		}
+		x = ((uint32_t)(p[0] & 0x0f) << 8) | p[1];
+		y = ((uint32_t)(p[2] & 0x0f) << 8) | p[3];
+		if (x > 1079) {
+			x = 1079;
+		}
+		if (y > 2399) {
+			y = 2399;
+		}
+		mask |= 1u << id;
+		gt.x[id] = (int)x;
+		gt.y[id] = (int)y;
+	}
+
+	for (i = 0; i < GT_MAX; i++) {
+		if (mask & (1u << i)) {
+			sweet_hid_touch(i, 1, gt.x[i], gt.y[i]);
+		} else if (gt.active & (1u << i)) {
+			sweet_hid_touch(i, 0, gt.x[i], gt.y[i]);
+		}
+	}
+	gt.active = mask;
+	return 0;
+}
