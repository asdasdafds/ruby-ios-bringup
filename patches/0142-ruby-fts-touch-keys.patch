+/*
+ * ---- MTK keypad (mediatek,kp @ 0x10010000) ----
+ *
+ * KP_MEM1..5 hold the debounced matrix, one 16-bit word each, bit clear =
+ * pressed; hardware key n is MEM(n / 16) bit (n % 16).  ruby's live FDT:
+ * kpd-hw-init-map[0] = 114 (volume down), kpd-hw-pwrkey = 8 (116 power),
+ * kpd-hw-rstkey = 17 (115 volume up).  Every changed bit is logged so an
+ * unexpected layout shows up in sweetlog.  Read-only; LK leaves it running.
+ */
+#define KP_PA		0x10010000u
+#define KP_MEM(i)	(0x04u + (i) * 4u)
+#define KP_NMEM		5
+
+static const struct {
+	unsigned bit;
+	int key;	/* sweet_hid_key: 0 power, 1 volume up, 2 volume down */
+} kp_map[] = {
+	{ 0, 2 }, { 8, 0 }, { 17, 1 },
+};
+
+static int kp_sleep_chan;
+
+static void
+kp_thread(void *arg, wait_result_t wr)
+{
+	vm_offset_t kp;
+	uint32_t prev[KP_NMEM], cur, diff;
+	uint64_t deadline;
+	unsigned i, j, k;
+
+	(void)arg;
+	(void)wr;
+
+	kp = ml_io_map(KP_PA, 0x1000);
+	if (!kp) {
+		printf("SWEET KEYS: keypad mapping failed\n");
+		goto out;
+	}
+	for (i = 0; i < KP_NMEM; i++) {
+		prev[i] = *(volatile uint32_t *)(kp + KP_MEM(i)) & 0xffff;
+	}
+	printf("SWEET KEYS: keypad mem %04x %04x %04x %04x %04x, polling\n",
+	    prev[0], prev[1], prev[2], prev[3], prev[4]);
+
+	for (;;) {
+		for (i = 0; i < KP_NMEM; i++) {
+			cur = *(volatile uint32_t *)(kp + KP_MEM(i)) & 0xffff;
+			diff = cur ^ prev[i];
+			for (j = 0; diff && j < 16; j++) {
+				unsigned bit = i * 16 + j;
+				int down = !(cur & (1u << j)), key = -1;
+
+				if (!(diff & (1u << j))) {
+					continue;
+				}
+				for (k = 0; k < sizeof(kp_map) / sizeof(kp_map[0]); k++) {
+					if (kp_map[k].bit == bit) {
+						key = kp_map[k].key;
+					}
+				}
+				printf("SWEET KEYS: kp bit %u %s%s\n", bit,
+				    down ? "down" : "up", key < 0 ? " (unmapped)" : "");
+				if (key >= 0) {
+					sweet_hid_key(key, down);
+				}
+			}
+			prev[i] = cur;
+		}
+		clock_interval_to_deadline(20, NSEC_PER_MSEC, &deadline);
+		(void)assert_wait_deadline(&kp_sleep_chan, THREAD_UNINT, deadline);
+		thread_block(THREAD_CONTINUE_NULL);
+	}
+
+out:
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+kp_init(void)
+{
+	int enabled = 1;
+	thread_t thread;
+	kern_return_t kr;
+
+	if (PE_parse_boot_argn("sweetkeys", &enabled, sizeof(enabled)) && !enabled) {
+		printf("SWEET KEYS: disabled (sweetkeys=0)\n");
+		return;
+	}
+	kr = kernel_thread_start(kp_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("SWEET KEYS: thread start failed %d\n", kr);
+	}
+}
